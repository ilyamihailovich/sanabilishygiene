# Адрес сервиса для пользователей (поддомен за nginx с HTTPS)
APP_URL=https://hygiene.sanabilis.ru
# Секрет приложения: подписи, шифрование ссылок пациентов. Не меньше 32 символов, хранить в тайне.
# Сгенерировать: openssl rand -base64 48
APP_SECRET=
# Cookie только по HTTPS
COOKIE_SECURE=true

# База данных
POSTGRES_USER=sanabilis
POSTGRES_PASSWORD=
POSTGRES_DB=sanabilis

# Первый администратор (создаётся при первом запуске; временный пароль выводится в лог, если пароль не задан)
SEED_ADMIN_EMAIL=admin@sanabilis.ru
SEED_ADMIN_PASSWORD=

# Резервное копирование
BACKUP_KEEP=14
# Пароль шифрования копий (обязательно сохранить отдельно, без него копию не восстановить)
BACKUP_PASSPHRASE=
# Необязательно: куда копировать вне сервера (rsync), например backup@storage.example.ru:/backups/sanabilis
BACKUP_REMOTE=
