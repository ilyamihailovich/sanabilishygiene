# Адрес сервиса для пользователей (поддомен за nginx с HTTPS)
APP_URL=https://hygiene.sanabilis.ru
# Секрет приложения: подписи, шифрование ссылок пациентов. Не меньше 32 символов, хранить в тайне.
# Сгенерировать: openssl rand -base64 48
APP_SECRET=
# Cookie только по HTTPS
COOKIE_SECURE=true

# База данных
POSTGRES_USER=sanabilis
POSTGRES_PASSWORD=
POSTGRES_DB=sanabilis

# Первый администратор (создаётся при первом запуске; временный пароль выводится в лог, если пароль не задан)
SEED_ADMIN_EMAIL=admin@sanabilis.ru
SEED_ADMIN_PASSWORD=

# Резервное копирование
BACKUP_KEEP=14
# Пароль шифрования копий (обязательно сохранить отдельно, без него копию не восстановить)
BACKUP_PASSPHRASE=
# Необязательно: куда копировать вне сервера (rsync), например backup@storage.example.ru:/backups/sanabilis
BACKUP_REMOTE=

# Диктовка карты: сервис распознавания речи с API, совместимым с OpenAI (POST <STT_URL>/audio/transcriptions).
# Без STT_URL работает распознавание браузера (Chrome — Google, Safari — Apple).
# Свой сервер в клинике (звук не покидает сеть):  STT_URL=http://whisper:8000/v1  STT_MODEL=Systran/faster-whisper-medium  STT_PRIVATE=true
# Groq (бесплатный лимит, серверы в США):          STT_URL=https://api.groq.com/openai/v1  STT_KEY=...  STT_MODEL=whisper-large-v3-turbo
# OpenAI:                                          STT_URL=https://api.openai.com/v1  STT_KEY=...  STT_MODEL=gpt-4o-mini-transcribe
# STT_URL=
# STT_KEY=
# STT_MODEL=whisper-1
# STT_PRIVATE=false
