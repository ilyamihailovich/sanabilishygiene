nabled":true},{"id":"s000e","items":[{"id":"i000f","text":"Начиная с вечера дня процедуры чистите зубы и межзубные промежутки в обычном режиме. При чувствительности используйте пасту для чувствительных зубов.","type":"text","value":"","enabled":true,"required":false,"selected":[]}],"title":"Гигиена","enabled":true},{"id":"s000g","items":[{"id":"i000h","text":"Если чувствительность или кровоточивость сохраняются дольше 7 дней, свяжитесь с клиникой.","type":"warning","title":"Когда обратиться в клинику","value":"","enabled":true,"required":false,"selected":[]}],"title":"Когда обратиться в клинику","enabled":true}],"templateId":"cmvik2c950006q07dmcpapc66","templateVersion":1},"templateVersionId":"cmvik2c960007q07d6hop0o1t"}],"catalog":[{"id":"cmviqbdxb0001v97dxlh9ta6r","brand":"Межзубный ёршик","line":"цилиндрический","label":"ISO 0","isoSize":null,"passageMm":"0.6","bristleDiameterMm":null,"colorHex":"#f2c94c","verified":true,"sortOrder":1,"hasPhoto":false,"archived":false},{"id":"cmviqbdxx0002v97dpy3dp3u6","brand":"Межзубный ёршик","line":"цилиндрический","label":"ISO 1","isoSize":null,"passageMm":"0.8","bristleDiameterMm":null,"colorHex":"#e86a3a","verified":true,"sortOrder":2,"hasPhoto":false,"archived":false},{"id":"cmviqbdye0003v97dhl2lnwho","brand":"Межзубный ёршик","line":"цилиндрический","label":"ISO 2","isoSize":null,"passageMm":"1","bristleDiameterMm":null,"colorHex":"#3f8f5a","verified":true,"sortOrder":3,"hasPhoto":false,"archived":false},{"id":"cmviqbdyx0004v97dxlmwfxvv","brand":"Межзубный ёршик","line":"цилиндрический","label":"ISO 4","isoSize":null,"passageMm":"1.3","bristleDiameterMm":null,"colorHex":"#2f6fb5","verified":true,"sortOrder":4,"hasPhoto":false,"archived":false}],"templates":[{"id":"cmvik2c8x0004q07docx7y2x2","kind":"HYGIENE_PLAN","title":"Схема индивидуальной гигиены","personal":false,"archived":false,"version":1,"updatedAt":"2026-10-21T20:19:15.201Z","hasDraft":false,"structure":{"schema":1,"sections":[{"id":"s0001","items":[{"id":"i0002","text":"Чистите зубы 2 раза в день, утром и вечером, по 2–3 минуты. Используйте щётку с мягкой щетиной и пасту с фтором. Меняйте щётку раз в 3 месяца или раньше, если щетина потеряла форму.","type":"text","required":false}],"title":"Зубная щётка и паста"},{"id":"s0003","items":[{"id":"i0004","type":"brushes","required":false},{"id":"i0005","text":"Очищайте межзубные промежутки 1 раз в день, удобнее вечером перед тем, как почистить зубы. Для каждого промежутка используйте ёршик указанного размера. Между центральными резцами используйте зубную нить.","type":"text","required":false}],"title":"Межзубные промежутки"},{"id":"s0006","items":[{"id":"i0007","text":"Очищайте язык скребком 1 раз в день, утром.","type":"text","required":false}],"title":"Дополнительные средства"},{"id":"s0008","items":[{"id":"i0009","text":"Если кровоточивость сохраняется дольше 2 недель регулярного ухода, появились боль, отёк или подвижность зуба, запишитесь на осмотр.","type":"warning","title":"Когда обратиться в клинику","required":false}],"title":"Когда обратиться в клинику"}]}},{"id":"cmvik2c950006q07dmcpapc66","kind":"AFTERCARE","title":"После профессиональной гигиены","personal":false,"archived":false,"version":1,"updatedAt":"2026-10-21T20:19:15.209Z","hasDraft":false,"structure":{"schema":1,"sections":[{"id":"s000a","items":[{"id":"i000b","text":"В течение 2 часов после процедуры воздержитесь от еды. В первые дни возможна повышенная чувствительность зубов к холодному и горячему.","type":"text","required":false}],"title":"Первые часы"},{"id":"s000c","items":[{"id":"i000d","text":"В первые сутки исключите кофе, чай, красное вино, ягоды и другие окрашивающие продукты. На этот срок откажитесь от курения.","type":"text","required":false}],"title":"Питание"},{"id":"s000e","items":[{"id":"i000f","text":"Начиная с вечера дня процедуры чистите зубы и межзубные промежутки в обычном режиме. При чувствительности используйте пасту для чувствительных зубов.","type":"text","required":false}],"title":"Гигиена"},{"id":"s000g","items":[{"id":"i000h","text":"Если чувствительность или кровоточивость сохраняются дольше 7 дней, свяжитесь с клиникой.","type":"warning","title":"Когда обратиться в клинику","required":false}],"title":"Когда обратиться в клинику"}]}},{"id":"cmvik2c9e0008q07dvug6fyo3","kind":"AFTERCARE","title":"После удаления зуба","personal":false,"archived":false,"version":1,"updatedAt":"2026-10-21T20:19:15.218Z","hasDraft":false,"structure":{"schema":1,"sections":[{"id":"s000i","items":[{"id":"i000j","text":"Держите марлевый тампон 20–30 минут. Не полощите рот и не касайтесь лунки языком: в ней формируется сгусток, который защищает рану.","type":"text","required":false}],"title":"Первые сутки"},{"id":"s000k","items":[{"id":"i000l","text":"Воздержитесь от еды 2 часа. В первые сутки выбирайте мягкую пищу комнатной температуры и жуйте на противоположной стороне.","type":"text","required":false}],"title":"Питание"},{"id":"s000m","items":[{"id":"i000n","text":"Чистите зубы в обычном режиме, аккуратно обходя область удаления. В соседних промежутках используйте ёршики со следующего дня.","type":"text","required":false}],"title":"Гигиена"},{"id":"s000o","items":[{"id":"i000p","text":"В течение 3 дней исключите горячую ванну, сауну, физические нагрузки, курение и алкоголь.","type":"text","required":false}],"title":"Ограничения"},{"id":"s000q","items":[{"id":"i000r","text":"Если кровотечение не останавливается, боль усиливается на 2–3 день, повысилась температура или появился отёк, свяжитесь с клиникой.","type":"warning","title":"Когда обратиться в клинику","required":false}],"title":"Когда обратиться в клинику"}]}},{"id":"cmvik2c9k000aq07dh7ci6umd","kind":"AFTERCARE","title":"После имплантации","personal":false,"archived":false,"version":1,"updatedAt":"2026-10-21T20:19:15.224Z","hasDraft":false,"structure":{"schema":1,"sections":[{"id":"s000s","items":[{"id":"i000t","text":"Прикладывайте холод к щеке в области операции по 15 минут с перерывами в течение первых часов.","type":"text","required":false}],"title":"Первые сутки"},{"id":"s000u","items":[{"id":"i000v","text":"Пока действует анестезия, воздержитесь от еды. В первые дни выбирайте мягкую пищу комнатной температуры и не жуйте на стороне операции.","type":"text","required":false}],"title":"Питание"},{"id":"s000w","items":[{"id":"i000x","text":"Чистите зубы в обычном режиме, область операции щёткой не затрагивайте до осмотра. Полоскания назначает врач.","type":"text","required":false}],"title":"Гигиена"},{"id":"s000y","items":[{"id":"i000z","text":"До снятия швов исключите сауну, бассейн, физические нагрузки, курение и алкоголь.","type":"text","required":false}],"title":"Ограничения"},{"id":"s0010","items":[{"id":"i0011","text":"Если отёк нарастает после 3 дня, кровотечение не останавливается или повысилась температура, свяжитесь с клиникой.","type":"warning","title":"Когда обратиться в клинику","required":false}],"title":"Когда обратиться в клинику"}]}},{"id":"cmvik2c9o000cq07db0zuofne","kind":"AFTERCARE","title":"После установки ортодонтической системы","personal":false,"archived":false,"version":1,"updatedAt":"2026-10-21T20:19:15.228Z","hasDraft":false,"structure":{"schema":1,"sections":[{"id":"s0012","items":[{"id":"i0013","text":"В первые 3–5 дней возможны ощущение давления и чувствительность зубов. Так проявляется начало перемещения зубов.","type":"text","required":false}],"title":"Первые дни"},{"id":"s0014","items":[{"id":"i0015","text":"Исключите твёрдую и липкую пищу: орехи, сухари, ириски, жевательную резинку. Яблоки и морковь нарезайте небольшими кусочками.","type":"text","required":false}],"title":"Питание"},{"id":"s0016","items":[{"id":"i0017","text":"Чистите зубы после каждого приёма пищи. Пространство под дугой и вокруг замков очищайте ёршиками по схеме.","type":"text","required":false}],"title":"Гигиена"},{"id":"s0018","items":[{"id":"i0019","text":"Если элемент ортодонтической системы отклеился, сломался или травмирует слизистую, свяжитесь с клиникой.","type":"warning","title":"Когда обратиться в клинику","required":false}],"title":"Когда обратиться в клинику"}]}}]}