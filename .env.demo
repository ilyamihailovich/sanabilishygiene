# Просмотр на своём компьютере: docker compose --env-file .env.demo up -d --build
# Не для рабочего сервера: секреты здесь общеизвестные, включены демо-данные.
APP_URL=http://localhost:3000
APP_SECRET=local-demo-secret-not-for-production-0123456789
COOKIE_SECURE=false
POSTGRES_USER=sanabilis
POSTGRES_PASSWORD=local-demo-password
POSTGRES_DB=sanabilis
SEED_ADMIN_EMAIL=admin@sanabilis.local
SEED_ADMIN_PASSWORD=admin-password
SEED_DEMO=true
BACKUP_KEEP=3
BACKUP_PASSPHRASE=local-demo-backup
